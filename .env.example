# UniACMIS — copy to .env for local development.
#   cp .env.example .env
# Defaults below are development-only. Production boot fails on the default SECRET_KEY.

# ---------------------------------------------------------------- Django core
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-insecure-key-change-me-before-any-real-deployment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------- Database
# Host is `db` inside Docker Compose, `localhost` when running outside it.
DATABASE_URL=postgres://uniacmis:uniacmis@db:5432/uniacmis
POSTGRES_DB=uniacmis
POSTGRES_USER=uniacmis
POSTGRES_PASSWORD=uniacmis
# Host port the container publishes on. 5433 avoids clashing with a PostgreSQL
# already installed on the machine; connect from the host with
#   psql -h localhost -p 5433 -U uniacmis uniacmis
POSTGRES_HOST_PORT=5433

# -------------------------------------------------------------- Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ----------------------------------------------------------- Locale / currency
TIME_ZONE=Africa/Juba
LANGUAGE_CODE=en-us
DEFAULT_CURRENCY=SSP
SECONDARY_CURRENCY=USD

# ------------------------------------------------------------------- Providers
# Swapped for real integrations in Phases 4 (payments) and 6 (SMS) without code changes.
NOTIFICATION_PROVIDER=apps.core.providers.notifications.ConsoleNotificationProvider
PAYMENT_PROVIDER=apps.core.providers.payments.MockPaymentProvider

# --------------------------------------------------------------------- Storage
FILE_STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=5
# Only used when FILE_STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=uniacmis
MINIO_SECRET_KEY=uniacmis-secret
MINIO_BUCKET=uniacmis

# ----------------------------------------------------------------------- Auth
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ------------------------------------------------------- Development switches
# Registers a stub fee-balance hold provider so registration holds are
# demonstrable before the finance module exists (Phase 4). Never enable in production.
ENABLE_DEMO_HOLD_PROVIDER=True

# ------------------------------------------------------------------- Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
